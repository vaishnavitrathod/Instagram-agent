# ---------- Captions: Gemini (free tier, no card) ----------
TEXT_PROVIDER=gemini
GEMINI_API_KEY=AIza...
# Tried in order; a busy/retired model just moves on to the next
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash

# ---------- Images: Pollinations (free key from enter.pollinations.ai) ----------
IMAGE_PROVIDERS=pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
# Optional backup (free): Cloudflare Workers AI
# IMAGE_PROVIDERS=pollinations,cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ---------- Public image hosting (free): cloudinary.com ----------
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ---------- Instagram Graph API ----------
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v26.0

BRAND_VOICE=friendly, visual, a little witty
BANNED_WORDS=guarantee,free money

# 1 = never touch Instagram or Cloudinary (prints what would happen)
DRY_RUN=1
# 1 = skip text AND image APIs: placeholder text + placeholder image
FAKE_LLM=0
